NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/fastor7_crm
# Required: generate a private random value with at least 32 characters.
JWT_SECRET=
JWT_EXPIRES_IN=1d
CORS_ORIGIN=http://localhost:3000
TRUST_PROXY=false
JSON_BODY_LIMIT=100kb
BCRYPT_SALT_ROUNDS=12

# Global API limiter: 120 requests per 15 minutes
GLOBAL_RATE_LIMIT_WINDOW_MS=900000
GLOBAL_RATE_LIMIT_MAX=120

# Registration limiter: 5 requests per hour
REGISTER_RATE_LIMIT_WINDOW_MS=3600000
REGISTER_RATE_LIMIT_MAX=5

# Login limiter: 10 requests per 15 minutes
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=10

# Public enquiry limiter: 20 requests per hour
PUBLIC_LEAD_RATE_LIMIT_WINDOW_MS=3600000
PUBLIC_LEAD_RATE_LIMIT_MAX=20

# Claim limiter: 60 requests per minute
CLAIM_RATE_LIMIT_WINDOW_MS=60000
CLAIM_RATE_LIMIT_MAX=60

